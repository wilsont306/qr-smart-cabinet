# Google Sheets mirror (optional). Leave unset to keep the app fully in-memory.
# See docs/GOOGLE_SHEETS.md for setup.
#
# Fast path (recommended) — Google Sheets API via service account (~200–800ms):
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or paste the whole JSON key as one line:
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Fallback — Apps Script Web App (slower cold starts):
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# HMAC secret for signed session cookies (required for multi-instance / Vercel).
# Use a long random string, e.g. `openssl rand -hex 32`.
# Falls back to SHEETS_SECRET if unset.
SESSION_SECRET=

# Optional. Protects /api/sheets/warmup when set (Vercel Cron sends the bearer).
CRON_SECRET=
